global:
  resolve_timeout: 5m
  smtp_smarthost: '${SMTP_SMARTHOST}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_AUTH_USERNAME}'
  smtp_auth_password: '${SMTP_AUTH_PASSWORD}'

route:
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'alert-receivers'

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance', 'service']

receivers:
- name: 'alert-receivers'
  email_configs:
  - to: '${EMAIL_TO}'
    require_tls: true
    send_resolved: true
  slack_configs:
  - api_url: '${DISCORD_WEBHOOK_URL}'
    channel: '${DISCORD_CHANNEL}'
    send_resolved: true
    title: '{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}'
    title_link: ''
    text: "{{ range .Alerts }}*Resumo:* {{ .Annotations.summary }}\n*Descrição:* {{ .Annotations.description }}\n*Severidade:* {{ .Labels.severity }}\n{{ end }}"
    fallback: '{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}'
    footer: 'BidLive Alertmanager'
